# Ignore build artifacts: the esbuild bundle + SEA binaries (dist/, the real
# build output), the cross-build node cache (build/), and coverage reports.
# ESLint ignores the same set; Prettier reads only this file, not .gitignore.
build
dist
coverage

# Never let Prettier touch snapshot manifests or the on-disk store
.s3cab
*.tsv
*.tsv.zst

# Docs are hand-authored. Prettier's Markdown formatting churns prose emphasis
# (*x* -> _x_) and pads table cells with trailing whitespace, which makes the
# frequently AI-edited CLAUDE.md tables fragile to edit. Keep md out.
*.md
