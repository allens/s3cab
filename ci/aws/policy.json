{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TestBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::s3cab-ci-test/*"
    },
    {
      "Sid": "TestBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::s3cab-ci-test"
    }
  ]
}
