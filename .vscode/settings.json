{
  "nodejs-testing.extensions": [
    {
      "extensions": ["mjs", "cjs", "js"],
      "parameters": ["--experimental-test-module-mocks"]
    }
  ],
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "search.exclude": {
    "**/.claude/worktrees": true
  },
  "files.watcherExclude": {
    "**/.claude/worktrees/**": true
  }
}
