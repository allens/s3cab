{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebFetch(domain:docs.claude.com)",
      "Read(/tmp/**)"
    ],
    "deny": [
      "Bash(git -C *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(npm run clean)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * +*)",
      "Bash(rm -rf *)"
    ],
    "additionalDirectories": ["\\tmp"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-destructive-rm.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
