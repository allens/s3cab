{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-remote *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(npm audit *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm install --package-lock-only *)",
      "Bash(npm list *)",
      "Bash(npm outdated*)",
      "Bash(npm run build*)",
      "Bash(npm run clean:dry)",
      "Bash(npm run format*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm show *)",
      "Bash(npm test*)",
      "Bash(npm update *)",
      "Bash(npm view *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx tsc*)",
      "Bash(node --test*)",
      "Bash(node src/s3cab.mjs*)",
      "Bash(npm pack *)",
      "Bash(echo *)",
      "Bash(diff *)",
      "Bash(gh auth *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(rm .git/PR_BODY_TMP.md)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebFetch(domain:docs.claude.com)",
      "Read(/tmp/**)",
      "Bash(npm ci *)"
    ],
    "deny": [
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(npm run clean)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *+*)",
      "Bash(rm -rf *)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  }
}
