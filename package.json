{
  "name": "s3cab",
  "version": "0.0.1",
  "description": "Open eternal S3 content addressable backup",
  "keywords": [
    "backup",
    "s3"
  ],
  "homepage": "https://github.com/allens/s3cab#readme",
  "bugs": {
    "url": "https://github.com/allens/s3cab/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "Allen Shiels <allen@shiels.dev> (https://github.com/allens/)",
  "bin": {
    "s3cab": "src/s3cab.mjs"
  },
  "files": [
    "src",
    "doc",
    "!src/**/*.test.mjs"
  ],
  "repository": "allens/s3cab.git",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --experimental-test-module-mocks \"src/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "test:s3": "node --test --env-file-if-exists=.env.test src/lib/remote.test.mjs src/commands/restore.test.mjs",
    "test:watch": "npm run test -- --watch",
    "test:snapshot": "npm run test -- --test-update-snapshots",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info \"src/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "test:coverage:report": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-exclude=\"**/*.test.mjs\" --test-coverage-exclude=\"scripts/**\" \"src/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "build": "esbuild src/s3cab.mjs --bundle --outdir=dist --platform=node --format=esm --external:aws-crt",
    "build:win": "npm run build && node --build-sea=sea/win-x64.json",
    "build:linux": "npm run build && node --build-sea=sea/linux-x64.json",
    "clean": "git clean -fdX",
    "clean:dry": "git clean -ndX"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.947.0",
    "@aws-sdk/credential-providers": "^3.947.0",
    "@aws-sdk/lib-storage": "^3.947.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "esbuild": "0.28.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.7.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26.3.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
