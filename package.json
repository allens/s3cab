{
  "name": "s3cab",
  "version": "0.0.1",
  "description": "Open eternal S3 content addressable backup",
  "keywords": [
    "backup",
    "s3"
  ],
  "homepage": "https://github.com/allens/s3cab#readme",
  "bugs": {
    "url": "https://github.com/allens/s3cab/issues"
  },
  "license": "GPL-3.0-or-later",
  "author": "Allen Shiels <allen@shiels.dev> (https://github.com/allens/)",
  "main": "src/cli.mjs",
  "bin": "dist/s3cab.js",
  "repository": "allens/s3cab.git",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:watch": "npm run test -- --watch",
    "test:snapshot": "npm run test -- --test-update-snapshots",
    "test:coverage": "npm run test -- --experimental-test-coverage --test-reporter=spec --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=lcov.info",
    "build": "node build.cjs",
    "build:exe": "npm run build && node --build-sea=sea-config.json",
    "build:cross": "npm run build && node scripts/build-sea-cross.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.947.0",
    "@aws-sdk/client-sso": "^3.947.0",
    "@aws-sdk/client-sso-oidc": "^3.947.0",
    "@aws-sdk/lib-storage": "^3.947.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.7.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26.3.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
