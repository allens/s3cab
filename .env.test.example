# Local S3 integration-test config. Copy to `.env.test` (gitignored) and edit.
#
# Non-secret only — no credentials here. `npm run test:s3` relocates s3cab's home
# (S3CAB_HOME) but leaves HOME alone, so the AWS SDK reads your ~/.aws profile/SSO
# session directly. AWS_PROFILE just picks which profile.

S3CAB_TEST_BUCKET=your-test-bucket
AWS_REGION=us-east-1
# AWS_PROFILE=your-profile   # uncomment to use a non-default ~/.aws profile
