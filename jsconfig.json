{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "checkJs": true,
    "resolveJsonModule": true,
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    // Transitive deps ship npm shims of Node builtins (events via
    // @aws-sdk/lib-storage, string_decoder via readable-stream, punycode via
    // eslint's ajv). Bare imports of those names resolve to the shims' untyped
    // CJS instead of the builtin, and checkJs then reports their internals.
    // Map the names back to the builtin declarations so the check stays clean.
    "paths": {
      "events": ["./node_modules/@types/node/events.d.ts"],
      "punycode": ["./node_modules/@types/node/punycode.d.ts"],
      "string_decoder": ["./node_modules/@types/node/string_decoder.d.ts"]
    }
  },
  // With no "include", tsc takes everything under the root except "exclude" —
  // but that default traversal skips **dot-directories**, so a vendored skill's
  // own script under `.claude/skills/` would go unchecked. Naming both keeps the
  // default's reach and adds that one tree; `.claude/worktrees/` stays out (each
  // is a full checkout of this repo, and eslint ignores it for the same reason).
  "include": ["**/*", ".claude/skills/**/*"],
  "exclude": ["node_modules", "dist", ".claude/worktrees"]
}
