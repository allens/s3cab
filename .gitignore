# Dependencies
node_modules/

# Logs & diagnostic reports
*.log
npm-debug.log*
report.*.json

# Caches
.npm
.eslintcache
*.tsbuildinfo

# Test & coverage output
coverage/
*.lcov
lcov.info
.nyc_output
test/.tmp*
/test/snapshots/
test/blob.bin
test/zblob.bin

# Secrets / local env. s3cab no longer reads a cwd .env (see docs/specs/auth.md), but
# keep it ignored as it's a near-universal secret file. A stray env under the
# repo's /.s3cab/ (which only ships the exclude.txt template now that config is
# per-set under ~/.s3cab) is guarded too so AWS creds can't be committed by
# accident — root-anchored, so the tracked /.s3cab/exclude.txt is unaffected.
.env
.env.test
/.s3cab/env
/.s3cab/env.*
# Temp files from the ci/aws provisioning runbook: the trust policy is committed
# with an ACCOUNT_ID placeholder, then substituted into a *.tmp.json at apply time
# so the real account ID never lands in this public repo. Guard against a stray one
# being staged if a run errors before its cleanup.
*.tmp.json

# Build artifacts: esbuild ESM bundle (dist/s3cab.js), the SEA native binaries
# (dist/s3cab.exe and cross-built dist/s3cab-<platform>) — everything in dist/.
/dist/
# Cross-build cache: downloaded + extracted node binaries for other platforms.
/build/

# npm pack output
*.tgz

# OS / editor junk
.DS_Store
Thumbs.db

# Claude Code local (personal) settings
.claude/settings.local.json

# Claude Code worktrees. The harness (EnterWorktree / --worktree) creates
# per-session worktrees here; ignored so the main checkout's git, search,
# watchers, and lint don't wander into a nested working tree (see CLAUDE.md's worktree convention).
.claude/worktrees/

# Transient snapshot temp/lock file and the --debug decompressed copy. Snapshots
# themselves now live in ~/.s3cab/sets/<set>/snapshots/ (outside any working
# copy), so no in-repo snapshot-output rule is needed any more.
.snapshot.tsv
.snapshot.tsv.zst
snapshot-log.tsv

# Ad-hoc scratch/debug dumps
tree.txt
snapshot.txt
objects.txt
