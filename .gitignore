# Dependencies
node_modules/

# Logs & diagnostic reports
*.log
npm-debug.log*
report.*.json

# Caches
.npm
.eslintcache
*.tsbuildinfo

# Test & coverage output
coverage/
*.lcov
lcov.info
.nyc_output
test/.tmp*
/test/snapshots/
test/blob.bin
test/zblob.bin

# Secrets / local env. s3cab no longer reads a cwd .env (see specs/auth.md), but
# keep it ignored as it's a near-universal secret file. The repo's own dogfood
# per-folder env (/.s3cab/env, which can carry AWS creds) is ignored too so it
# can't be committed by accident — root-anchored, like the snapshots rule below,
# so the tracked /.s3cab/exclude.txt is unaffected.
.env
.env.test
/.s3cab/env
/.s3cab/env.*

# Build artifacts: esbuild ESM bundle (dist/s3cab.js), the SEA native binaries
# (dist/s3cab.exe and cross-built dist/s3cab-<platform>) — everything in dist/.
/dist/
# Cross-build cache: downloaded + extracted node binaries for other platforms.
/build/

# npm pack output
*.tgz

# OS / editor junk
.DS_Store
Thumbs.db

# Claude Code local (personal) settings
.claude/settings.local.json

# s3cab snapshot output from dogfooding on this repo. Anchored to the root so
# committed fixtures under test/fixtures/**/.s3cab/snapshots/ stay tracked.
/.s3cab/snapshots/
# Transient snapshot temp/lock file and the --debug decompressed copy.
.snapshot.tsv
.snapshot.tsv.zst
# Generated snapshot artifacts under test fixtures. The compare/ fixtures are
# hand-authored and committed; dir1's .s3cab output is produced by ad-hoc runs.
/test/fixtures/dir1/.s3cab/snapshots/
snapshot-log.tsv

# Ad-hoc scratch/debug dumps
tree.txt
snapshot.txt
objects.txt
